{
  "openapi": "3.0.0",
  "info": {
    "title": "Sierra Madre Check-In API",
    "version": "1.3.1",
    "description": "Microservicio de Check-in y Check-out (Equipo 11) respaldado por PostgreSQL (16 tablas oficiales PR11) con Adaptador Tolerante (ACL) para integraciÃ³n con Reservaciones, Cabinas, Banco y Embarque."
  },
  "servers": [
    {
      "url": "https://onrender.com",
      "description": "Servidor de ProducciÃ³n (Render)"
    },
    {
      "url": "http://localhost:3000",
      "description": "Servidor Local"
    }
  ],
  "paths": {
    "/api/check-in/reservations": {
      "get": {
        "summary": "Listar Reservaciones Registradas en PostgreSQL",
        "description": "Consulta todas las reservaciones almacenadas en Neon junto con sus pasajeros, cabina asignada y estado de registro de check-in.",
        "responses": {
          "200": {
            "description": "Lista de reservaciones obtenida correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id_reservacion": { "type": "integer", "example": 1 },
                          "num_reservacion": { "type": "string", "example": "RSV-FAM-01" },
                          "fecha_embarque": { "type": "string", "format": "date", "example": "2026-12-01" },
                          "fecha_desembarque": { "type": "string", "format": "date", "example": "2026-12-08" },
                          "estado_reservacion": { "type": "string", "example": "Vigente" },
                          "id_pasajero": { "type": "integer", "example": 1 },
                          "nombre_completo": { "type": "string", "example": "Carlos Ruiz" },
                          "num_cabina": { "type": "string", "example": "C-104" },
                          "id_checkin": { "type": "integer", "nullable": true, "example": 101 },
                          "estado_checkin": { "type": "string", "nullable": true, "example": "En proceso" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Recibir ReservaciÃ³n Externa (Adaptador Tolerante ACL)",
        "description": "Endpoint receptor para que el microservicio de Reservaciones envÃ­e pasajeros individuales o familias completas. Acepta campos adicionales sin rechazar la peticiÃ³n.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["clave_reserva"],
                "properties": {
                  "clave_reserva": { "type": "string", "example": "RSV-FAM-01" },
                  "cabina": { "type": "string", "example": "C-104" },
                  "fecha_embarque": { "type": "string", "format": "date", "example": "2026-12-01" },
                  "fecha_desembarque": { "type": "string", "format": "date", "example": "2026-12-08" },
                  "pasajeros": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "nombre": { "type": "string", "example": "Carlos Ruiz" },
                        "fecha_nacimiento": { "type": "string", "format": "date", "example": "1988-04-12" },
                        "telefono": { "type": "string", "example": "6621234567" },
                        "correo": { "type": "string", "example": "carlos@correo.com" },
                        "nacionalidad": { "type": "string", "example": "Mexicana" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "ReservaciÃ³n y pasajeros registrados en PostgreSQL" },
          "400": { "description": "Falta identificador de reservaciÃ³n" }
        }
      }
    },
    "/api/check-in/initiate": {
      "post": {
        "summary": "Iniciar Check-in (ST01)",
        "description": "Valida que la reservaciÃ³n exista en PostgreSQL, verifica regla de adultos/menores y abre Registro_checkin y cuenta.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "groupCode": { "type": "string", "example": "RSV-FAM-01" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Check-in iniciado exitosamente" },
          "404": { "description": "ReservaciÃ³n no encontrada" },
          "422": { "description": "Menores sin adulto acompaÃ±ante" }
        }
      }
    },
    "/api/check-in/confirm-reservation": {
      "post": {
        "summary": "Confirmar con Reservaciones (ST05)",
        "description": "EnvÃ­a los datos validados al microservicio de Reservaciones para su Visto Bueno.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "checkInId": { "type": "integer", "example": 1 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "ReservaciÃ³n confirmada" },
          "400": { "description": "Rechazado por Reservaciones" }
        }
      }
    },
    "/api/check-in/pay": {
      "post": {
        "summary": "Procesar Pago de Check-in (ST04)",
        "description": "EnvÃ­a el cargo al microservicio de Banco y registra en cargo, cobro, deposito y comprobante.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "checkInId": { "type": "integer", "example": 1 },
                  "amount": { "type": "number", "example": 150 },
                  "documentNumber": { "type": "string", "example": "4532015112830366" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Pago procesado y comprobante emitido" },
          "402": { "description": "Pago rechazado por Banco" }
        }
      }
    },
    "/api/check-in/cabins": {
      "get": {
        "summary": "Listar Cabinas",
        "description": "Devuelve las cabinas registradas en la tabla Cabina.",
        "responses": { "200": { "description": "Lista de cabinas" } }
      }
    },
    "/api/check-in/cabin": {
      "post": {
        "summary": "Asignar Cabina (ST06)",
        "description": "Consulta disponibilidad al microservicio de Cabinas, registra en Solicitud_cabina y actualiza Registro_checkin.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "checkInId": { "type": "integer", "example": 1 },
                  "cabinId": { "type": "string", "example": "C-104" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Cabina asignada" },
          "409": { "description": "Cabina no disponible" }
        }
      }
    },
    "/api/check-in/luggage": {
      "post": {
        "summary": "Registrar Equipaje (ST07)",
        "description": "Valida el lÃ­mite de equipaje segÃºn estatus VIP y guarda en Envio_equipaje y Pieza_equipaje.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "checkInId": { "type": "integer", "example": 1 },
                  "bagCount": { "type": "integer", "example": 1 },
                  "totalWeightKg": { "type": "number", "example": 18 },
                  "isVip": { "type": "boolean", "example": false }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Equipaje registrado" },
          "422": { "description": "ERR_LUGGAGE_LIMIT (Excede lÃ­mite)" }
        }
      }
    },
    "/api/check-in/checkout": {
      "post": {
        "summary": "Procesar Check-out (ST08-ST12)",
        "description": "Consulta daÃ±os al microservicio de Cabinas (reporte_estado), cobra cargos extra con Banco y cierra cuenta.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "checkInId": { "type": "integer", "example": 1 },
                  "documentNumber": { "type": "string", "example": "4532015112830366" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Check-out completado y cuenta cerrada" } }
      }
    },
    "/api/check-in/boarding-pass/{id}": {
      "get": {
        "summary": "Ver Pase de Abordar",
        "description": "Muestra la vista HTML del pase de abordar del pasajero.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "example": 1 } }
        ],
        "responses": { "200": { "description": "HTML del pase de abordar" } }
      }
    },
    "/api/check-in/{id}/qr": {
      "get": {
        "summary": "Obtener Pase QR (SU02) y Notificar a Embarque (CHK-EMB)",
        "description": "Genera el cÃ³digo QR en Base64 que apunta al pase de abordar y envÃ­a el payload DATOS_PASAJERO al microservicio de Embarque configurado en BOARDING_URL.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "example": 1 } }
        ],
        "responses": { "200": { "description": "QR generado en Base64 y estado de sincronizaciÃ³n con Embarque" } }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "example": "ERR_AGE_REQUIREMENT" },
              "message": { "type": "string", "example": "Minors require at least one adult." }
            }
          }
        }
      }
    }
  }
}
