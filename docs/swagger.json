{
  "openapi": "3.0.0",
  "info": {
    "title": "Sierra Madre Check-In API",
    "version": "1.2.0",
    "description": "Microservicio de Check-in y Check-out para el crucero Sierra Madre Resort & Casino. Integrado mediante variables de entorno con Reservaciones, Banco y Cabinas."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Servidor Local"
    },
    {
      "url": "https://onrender.com",
      "description": "Servidor de Producción (Render)"
    }
  ],
  "paths": {
    "/api/check-in/initiate": {
      "post": {
        "summary": "Iniciar Check-in (ST01)",
        "description": "Valida que la reservación exista, verifica regla de adultos/menores y registra a los pasajeros.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "groupCode": { "type": "string", "example": "FAM-001" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Check-in iniciado exitosamente" } }
      }
    },
    "/api/check-in/confirm-reservation": {
      "post": {
        "summary": "Confirmar con Reservaciones (ST05)",
        "description": "Envía los datos validados al microservicio de Reservaciones para su Visto Bueno.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "checkInId": { "type": "string", "format": "uuid" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Reservación confirmada" },
          "400": { "description": "Rechazado por Reservaciones" }
        }
      }
    },
    "/api/check-in/pay": {
      "post": {
        "summary": "Procesar Pago de Check-in (ST04)",
        "description": "Envía el cargo al microservicio de Banco y registra el pago.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "checkInId": { "type": "string", "format": "uuid" },
                  "amount": { "type": "number", "example": 150 },
                  "documentNumber": { "type": "string", "example": "11111111" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Pago procesado exitosamente" },
          "402": { "description": "Pago rechazado por Banco" }
        }
      }
    },
    "/api/check-in/cabins": {
      "get": {
        "summary": "Listar Cabinas",
        "description": "Devuelve el catálogo de cabinas y su ocupación actual.",
        "responses": { "200": { "description": "Lista de cabinas" } }
      }
    },
    "/api/check-in/cabin": {
      "post": {
        "summary": "Asignar Cabina (ST06)",
        "description": "Consulta disponibilidad al microservicio de Cabinas y asigna la cabina al pasajero.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "checkInId": { "type": "string", "format": "uuid" },
                  "cabinId": { "type": "string", "format": "uuid" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Cabina asignada" } }
      }
    },
    "/api/check-in/luggage": {
      "post": {
        "summary": "Registrar Equipaje (ST07)",
        "description": "Valida el límite de equipaje según estatus VIP.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "checkInId": { "type": "string", "format": "uuid" },
                  "bagCount": { "type": "number", "example": 2 },
                  "totalWeightKg": { "type": "number", "example": 20 },
                  "isVip": { "type": "boolean", "example": false }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Equipaje registrado" },
          "422": { "description": "ERR_LUGGAGE_LIMIT (Excede límite)" }
        }
      }
    },
    "/api/check-in/checkout": {
      "post": {
        "summary": "Procesar Check-out (ST08-ST12)",
        "description": "Consulta daños al microservicio de Cabinas y procesa cobro final con Banco si aplica.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "checkInId": { "type": "string", "format": "uuid" },
                  "documentNumber": { "type": "string", "example": "11111111" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Check-out y cobro exitoso" } }
      }
    },
    "/api/check-in/boarding-pass/{id}": {
      "get": {
        "summary": "Ver Pase de Abordar",
        "description": "Muestra la vista HTML del pase de abordar del pasajero.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "HTML del pase de abordar" } }
      }
    },
    "/api/check-in/{id}/qr": {
      "get": {
        "summary": "Obtener Pase QR (SU02)",
        "description": "Genera el código QR en Base64 que apunta al pase de abordar.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "QR generado en Base64" } }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "example": "ERR_AGE_REQUIREMENT" },
              "message": { "type": "string", "example": "Minors require an adult." }
            }
          }
        }
      }
    }
  }
}
